# Binance API Credentials (Required for Live Trading)
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET=your_secret_key_here

# Telegram Bot Credentials (Optional, for notifications)
TELEGRAM_BOT_TOKEN=your_telegram_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Web Terminal Security Passphrase & Session Encryption
ADMIN_PASSPHRASE=your_admin_passphrase_here
FLASK_SECRET_KEY=generate_random_32_bytes_hex_here

# Strategy Configuration (Defaults)
PAPER_MODE=true
FUTURES_MODE=false
MAX_DAILY_LOSS_PCT=0.05
MAX_CONSECUTIVE_LOSSES=3
